{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Taskbar Separators",
  "version": "0.1.0",
  "identifier": "net.pasq.taskbar-separators",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Taskbar Separators",
        "width": 560,
        "height": 680,
        "minWidth": 460,
        "minHeight": 420,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.png", "icons/icon.ico"]
  }
}
